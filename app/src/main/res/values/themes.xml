<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main Theme - Dark Mode Default -->
    <style name="Theme.DecisionGraveyard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/pending_container</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/accent_container</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">@color/danger_container</item>
        <item name="colorOnErrorContainer">@color/danger</item>

        <item name="colorTertiary">@color/success</item>
        <item name="colorOnTertiary">@color/primary_variant</item>
        <item name="colorTertiaryContainer">@color/success_container</item>
        <item name="colorOnTertiaryContainer">@color/success</item>

        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:colorEdgeEffect">@color/primary</item>
        <item name="rippleColor">@color/ripple</item>
        <item name="materialButtonStyle">@style/Widget.DecisionGraveyard.Button</item>
        <item name="chipStyle">@style/Widget.DecisionGraveyard.Chip</item>
        <item name="textInputStyle">@style/Widget.DecisionGraveyard.TextInput</item>

        <!-- Typography -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.DecisionGraveyard.DisplayLarge</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.DecisionGraveyard.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.DecisionGraveyard.TitleLarge</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.DecisionGraveyard.BodyLarge</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.DecisionGraveyard.LabelLarge</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextAppearance.DecisionGraveyard.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_bold</item>
    </style>

    <style name="TextAppearance.DecisionGraveyard.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="TextAppearance.DecisionGraveyard.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
    </style>

    <style name="TextAppearance.DecisionGraveyard.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="TextAppearance.DecisionGraveyard.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.DecisionGraveyard.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">56dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.DecisionGraveyard.Button.Filled" parent="Widget.DecisionGraveyard.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.DecisionGraveyard.Button.Secondary" parent="Widget.DecisionGraveyard.Button">
        <item name="backgroundTint">@color/surface_variant</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.DecisionGraveyard.Button.Good" parent="Widget.DecisionGraveyard.Button">
        <item name="backgroundTint">@color/success</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.DecisionGraveyard.Button.Bad" parent="Widget.DecisionGraveyard.Button">
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="TextAppearance.DecisionGraveyard.DisplayMetric" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/playfair_display</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.DecisionGraveyard.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_card_glass</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/border_glass</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple</item>
    </style>

    <style name="Widget.DecisionGraveyard.Card.Outcome" parent="Widget.DecisionGraveyard.Card">
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Chip Styles -->
    <style name="Widget.DecisionGraveyard.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="android:textColor">@color/chip_unselected_text</item>
        <item name="checkedIconTint">@color/chip_selected_text</item>
        <item name="chipStrokeColor">@color/divider</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">16dp</item>
    </style>

    <style name="Widget.DecisionGraveyard.Chip.Category" parent="Widget.DecisionGraveyard.Chip">
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Input Styles -->
    <style name="Widget.DecisionGraveyard.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/divider</item>
        <item name="boxBackgroundColor">@color/surface_panel</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="hintTextColor">@color/text_tertiary</item>
        <item name="cursorColor">@color/primary</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.DecisionGraveyard.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/transparent</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemRippleColor">@color/ripple</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.DecisionGraveyard.BottomNav.ActiveIndicator</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.DecisionGraveyard.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/pending_container</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DecisionGraveyard.Medium</item>
    </style>

    <!-- FAB Style -->
    <style name="Widget.DecisionGraveyard.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/primary</item>
        <item name="tint">@color/white</item>
        <item name="elevation">0dp</item>
        <item name="pressedTranslationZ">12dp</item>
    </style>

    <!-- Shape Appearances -->
    <style name="ShapeAppearance.DecisionGraveyard.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.DecisionGraveyard.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Toolbar Style -->
    <style name="Widget.DecisionGraveyard.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text_primary</item>
        <item name="background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.DecisionGraveyard.TitleLarge</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.DecisionGraveyard.Small</item>

        <!-- Dialog Themes -->
        <item name="alertDialogTheme">@style/ThemeOverlay.DecisionGraveyard.Dialog</item>
    </style>

    <!-- Full Screen Dialog Theme -->
    <style name="ThemeOverlay.DecisionGraveyard.FullScreenDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <style name="ThemeOverlay.DecisionGraveyard.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/surface_card</item>
        <item name="colorSurface">@color/surface_card</item>
    </style>
</resources>
