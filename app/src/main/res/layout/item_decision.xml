<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDecision"
    style="@style/Widget.DecisionGraveyard.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <View
            android:id="@+id/viewStatusStrip"
            android:layout_width="5dp"
            android:layout_height="0dp"
            android:background="@color/grey"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCategory"
            style="@style/Widget.DecisionGraveyard.Chip.Category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textColor="@color/white"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Health" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="BURIED" />

        <TextView
            android:id="@+id/tvDecisionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="14dp"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            app:layout_constraintEnd_toStartOf="@id/tvCountdown"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toBottomOf="@id/chipCategory"
            tools:text="Skip breakfast and buy junk food after a stressful call" />

        <TextView
            android:id="@+id/tvDecisionNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/tvCountdown"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toBottomOf="@id/tvDecisionTitle"
            tools:text="Impulse decision logged during a low-energy moment." />

        <LinearLayout
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_metric_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStatusBadge">

            <TextView
                android:id="@+id/tvCountdownValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="2d" />

            <TextView
                android:id="@+id/tvCountdownLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                tools:text="left" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/countdownProgress"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="14dp"
            app:indicatorColor="@color/primary"
            app:layout_constraintEnd_toStartOf="@id/tvCountdown"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toBottomOf="@id/tvDecisionNote"
            app:trackColor="@color/surface_variant"
            app:trackCornerRadius="999dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/tvTimeRemaining"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/tvCountdown"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toBottomOf="@id/countdownProgress"
            tools:text="Judgment in 2 days 4 hours" />

        <TextView
            android:id="@+id/tvDecisionDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toBottomOf="@id/tvTimeRemaining"
            tools:text="Buried 2 hours ago" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
