<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDecision"
    style="@style/Widget.DecisionGraveyard.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="4dp"
    app:rippleColor="@color/ripple">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Status Strip Indicator -->
        <View
            android:id="@+id/viewStatusStrip"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:background="@color/grey"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Category Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipCategory"
            style="@style/Widget.DecisionGraveyard.Chip.Category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textSize="11sp"
            app:chipMinHeight="24dp"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="MONEY" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_neutral"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="BURIED" />

        <!-- Decision Title -->
        <TextView
            android:id="@+id/tvDecisionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_semibold"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/tvCountdown"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toBottomOf="@id/chipCategory"
            tools:text="Buy that expensive coffee machine" />

        <!-- Description Preview -->
        <TextView
            android:id="@+id/tvDecisionNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/tvCountdown"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toBottomOf="@id/tvDecisionTitle"
            tools:text="Might regret this later but..." />

        <!-- Countdown Timer (Right Side) -->
        <LinearLayout
            android:id="@+id/tvCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStatusBadge">

            <TextView
                android:id="@+id/tvCountdownValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/pending"
                android:textSize="20sp"
                tools:text="2d" />

            <TextView
                android:id="@+id/tvCountdownLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                tools:text="left" />
        </LinearLayout>

        <!-- Countdown Progress Bar (Tension) -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/countdownProgress"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            app:indicatorColor="@color/pending"
            app:trackColor="@color/surface_elevated"
            app:trackThickness="4dp"
            app:layout_constraintEnd_toStartOf="@id/tvCountdown"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toBottomOf="@id/tvDecisionNote" />

        <!-- Time Remaining Label -->
        <TextView
            android:id="@+id/tvTimeRemaining"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@id/tvCountdown"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toBottomOf="@id/countdownProgress"
            tools:text="Judgment in 2d 14h 22m" />

        <!-- Created Date (Bottom) -->
        <TextView
            android:id="@+id/tvDecisionDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewStatusStrip"
            app:layout_constraintTop_toBottomOf="@id/tvTimeRemaining"
            tools:text="Buried 2 hours ago" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
