<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0F172A" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_main_radial" />
    <item>
        <shape android:shape="rectangle">
            <gradient
